# ─────────────────────────────────────────────────────────────
# Grand Suite — mẫu biến môi trường. Sao chép thành .env.local rồi điền.
# TUYỆT ĐỐI không commit giá trị thật.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
API_PORT=4000
PUBLIC_WEB_URL=http://localhost:3000

# PostgreSQL (Docker: db:5432 · local script: 127.0.0.1:55432)
DATABASE_URL="postgresql://grandsuite:grandsuite@127.0.0.1:55432/grandsuite?schema=public"

# Redis (Docker: redis:6379 · local script: 127.0.0.1:56379)
REDIS_URL="redis://127.0.0.1:56379"

# Secrets — bắt buộc. Sinh bằng: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-characters-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-characters-long"
COOKIE_SECRET="change-me-cookie-secret-at-least-32-characters-long"
CSRF_SECRET="change-me-csrf-secret-at-least-32-characters-long"
# 32 byte base64 — dùng cho mã hoá AES-256-GCM trường nhạy cảm
APP_ENCRYPTION_KEY="MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="

# Seed
SEED_MODE=demo
SEED_ADMIN_PASSWORD="GrandSuite@2026"

# Trợ lý AI (tuỳ chọn — để trống thì dùng rule engine offline)
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL=""

# Email (MailHog khi chạy compose)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Grand Suite <no-reply@grandsuite.vn>"

# Lưu trữ chứng từ
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Cổng thanh toán (sandbox/mock — điền khi go-live)
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
MOMO_PARTNER_CODE=""
MOMO_ACCESS_KEY=""
MOMO_SECRET_KEY=""
ZALOPAY_APP_ID=""
ZALOPAY_KEY1=""
STRIPE_SECRET_KEY=""

# Kênh OTA / mạng xã hội (để trống = dùng mock connector)
BOOKING_COM_API_KEY=""
AGODA_API_KEY=""
EXPEDIA_API_KEY=""
AIRBNB_API_KEY=""
TRAVELOKA_API_KEY=""
TRIP_COM_API_KEY=""
FACEBOOK_PAGE_TOKEN=""
INSTAGRAM_TOKEN=""
ZALO_OA_TOKEN=""
WHATSAPP_TOKEN=""
TIKTOK_TOKEN=""

# Hoá đơn điện tử
EINVOICE_PROVIDER=mock
EINVOICE_BASE_URL=""
EINVOICE_USERNAME=""
EINVOICE_PASSWORD=""

# Sao lưu
BACKUP_DIR=./backups
