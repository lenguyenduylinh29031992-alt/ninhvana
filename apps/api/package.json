    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:reset": "prisma migrate reset --force",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@grand-suite/shared": "workspace:*",
