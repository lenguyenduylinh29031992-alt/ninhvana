// ───────────────────────── Reservations ─────────────────────────

enum ReservationStatus {
  PENDING
  CONFIRMED
  IN_HOUSE
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum ReservationRoomStatus {
  RESERVED
  IN_HOUSE
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

model Reservation {
  id                 String            @id @default(cuid())
  propertyId         String
  code               String
  status             ReservationStatus @default(CONFIRMED)
  channelId          String?
  companyId          String?
  primaryGuestId     String
  ratePlanId         String?
  checkIn            DateTime          @db.Date
  checkOut           DateTime          @db.Date
  nights             Int
  adults             Int               @default(1)
  children           Int               @default(0)
  roomsCount         Int               @default(1)
  currency           String            @default("VND")
  exchangeRate       Decimal           @default(1) @db.Decimal(18, 8)
  totalNet           Decimal           @default(0) @db.Decimal(18, 2)
  totalServiceCharge Decimal           @default(0) @db.Decimal(18, 2)
  totalTax           Decimal           @default(0) @db.Decimal(18, 2)
  totalAmount        Decimal           @default(0) @db.Decimal(18, 2)
  commissionAmount   Decimal           @default(0) @db.Decimal(18, 2)
  depositAmount      Decimal           @default(0) @db.Decimal(18, 2)
  paidAmount         Decimal           @default(0) @db.Decimal(18, 2)
  balance            Decimal           @default(0) @db.Decimal(18, 2)
  specialRequests    String?
  notes              String?
  source             String?
  createdById        String?
  checkedInAt        DateTime?
  checkedOutAt       DateTime?
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  property             Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  channel              Channel?              @relation(fields: [channelId], references: [id], onDelete: SetNull)
  company              Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  primaryGuest         Guest                 @relation(fields: [primaryGuestId], references: [id], onDelete: Restrict)
  ratePlan             RatePlan?             @relation(fields: [ratePlanId], references: [id], onDelete: SetNull)
  rooms                ReservationRoom[]
  folios               Folio[]
  payments             Payment[]
  invoices             Invoice[]
  serviceRequests      ServiceRequest[]
  externalReservations ExternalReservation[]

  @@unique([propertyId, code])
  @@index([propertyId, status, checkIn])
  @@index([propertyId, checkOut])
  @@index([primaryGuestId])
  @@index([createdAt])
}

model ReservationRoom {
  id                 String                @id @default(cuid())
  reservationId      String
  roomTypeId         String
  roomId             String?
  guestId            String?
  checkIn            DateTime              @db.Date
  checkOut           DateTime              @db.Date
  adults             Int                   @default(1)
  children           Int                   @default(0)
  status             ReservationRoomStatus @default(RESERVED)
  nightlyRate        Decimal               @db.Decimal(18, 2)
  totalNet           Decimal               @default(0) @db.Decimal(18, 2)
  totalServiceCharge Decimal               @default(0) @db.Decimal(18, 2)
  totalTax           Decimal               @default(0) @db.Decimal(18, 2)
  totalAmount        Decimal               @default(0) @db.Decimal(18, 2)
  folioId            String?
  keyCards           Int                   @default(0)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  reservation Reservation        @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  roomType    RoomType           @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  room        Room?              @relation(fields: [roomId], references: [id], onDelete: SetNull)
  guest       Guest?             @relation(fields: [guestId], references: [id], onDelete: SetNull)
  folio       Folio?             @relation(fields: [folioId], references: [id], onDelete: SetNull)
  nights      ReservationNight[]

  @@index([reservationId])
  @@index([roomId, checkIn, checkOut])
  @@index([roomTypeId, checkIn])
}

model ReservationNight {
  id                String   @id @default(cuid())
  reservationRoomId String
  businessDate      DateTime @db.Date
  rate              Decimal  @db.Decimal(18, 2)
  serviceCharge     Decimal  @default(0) @db.Decimal(18, 2)
  taxAmount         Decimal  @default(0) @db.Decimal(18, 2)
  total             Decimal  @db.Decimal(18, 2)
  postedFolioItemId String?
  journalized       Boolean  @default(false)
  commissionPosted  Boolean  @default(false)
  createdAt         DateTime @default(now())

  reservationRoom ReservationRoom @relation(fields: [reservationRoomId], references: [id], onDelete: Cascade)

  @@unique([reservationRoomId, businessDate])
  @@index([businessDate, journalized])
}

model Allotment {
  id         String   @id @default(cuid())
  propertyId String
  companyId  String
  roomTypeId String?
  dateFrom   DateTime @db.Date
  dateTo     DateTime @db.Date
  rooms      Int
  released   Int      @default(0)
  cutoffDays Int      @default(7)
  rateAmount Decimal  @db.Decimal(18, 2)
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([propertyId, dateFrom])
}

// ───────────────────────── Folio, payments, invoices ─────────────────────────

enum FolioStatus {
  OPEN
  SETTLED
  VOID
}

enum FolioItemType {
  ROOM_CHARGE
  FNB_CHARGE
  SPA_CHARGE
  EVENT_CHARGE
  OTHER_CHARGE
  PAYMENT
  REFUND
  DISCOUNT
  ADJUSTMENT
  TRANSFER
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  VIETQR
  VNPAY
  MOMO
  ZALO_PAY
  STRIPE
  COMPANY_AR
  LOYALTY_POINTS
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

model Folio {
  id            String      @id @default(cuid())
  propertyId    String
  number        String
  reservationId String?
  guestId       String
  companyId     String?
  type          String      @default("GUEST")
  status        FolioStatus @default(OPEN)
  currency      String      @default("VND")
  balance       Decimal     @default(0) @db.Decimal(18, 2)
  notes         String?
  openedAt      DateTime    @default(now())
  closedAt      DateTime?
  closedById    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  property    Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservation Reservation?      @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guest       Guest             @relation(fields: [guestId], references: [id], onDelete: Restrict)
  company     Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  items       FolioItem[]
  payments    Payment[]
  invoices    Invoice[]
  rooms       ReservationRoom[]

  @@unique([propertyId, number])
  @@index([propertyId, status])
  @@index([reservationId])
  @@index([guestId])
}

model FolioItem {
  id             String          @id @default(cuid())
  folioId        String
  propertyId     String
  businessDate   DateTime        @db.Date
  type           FolioItemType
  department     DepartmentGroup @default(ROOMS)
  description    String
  quantity       Decimal         @default(1) @db.Decimal(12, 3)
  unitPrice      Decimal         @default(0) @db.Decimal(18, 2)
  amount         Decimal         @default(0) @db.Decimal(18, 2)
  serviceCharge  Decimal         @default(0) @db.Decimal(18, 2)
  taxAmount      Decimal         @default(0) @db.Decimal(18, 2)
  total          Decimal         @default(0) @db.Decimal(18, 2)
  discount       Decimal         @default(0) @db.Decimal(18, 2)
  taxRateCode    String?
  glAccountCode  String?
  channelId      String?
  sourceType     String?
  sourceId       String?
  invoiceId      String?
  journalEntryId String?
  journalized    Boolean         @default(false)
  isVoid         Boolean         @default(false)
  voidReason     String?
  voidedAt       DateTime?
  voidedById     String?
  postedById     String?
  createdAt      DateTime        @default(now())

  folio   Folio    @relation(fields: [folioId], references: [id], onDelete: Cascade)
  channel Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([folioId, businessDate])
  @@index([propertyId, businessDate, journalized])
  @@index([propertyId, type])
  @@index([invoiceId])
}

model Payment {
  id              String        @id @default(cuid())
  propertyId      String
  folioId         String?
  invoiceId       String?
  reservationId   String?
  cashSessionId   String?
  method          PaymentMethod
  status          PaymentStatus @default(SUCCESS)
  amount          Decimal       @db.Decimal(18, 2)
  currency        String        @default("VND")
  exchangeRate    Decimal       @default(1) @db.Decimal(18, 8)
  amountVnd       Decimal       @db.Decimal(18, 2)
  businessDate    DateTime      @db.Date
  reference       String?
  gatewayTxnId    String?
  gatewayResponse Json?
  paidAt          DateTime      @default(now())
  createdById     String?
  refundedAmount  Decimal       @default(0) @db.Decimal(18, 2)

  folio       Folio?       @relation(fields: [folioId], references: [id], onDelete: SetNull)
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  refunds     Refund[]

  @@index([propertyId, paidAt])
  @@index([propertyId, businessDate])
  @@index([folioId])
  @@index([reservationId])
}

model Refund {
  id           String   @id @default(cuid())
  paymentId    String
  amount       Decimal  @db.Decimal(18, 2)
  reason       String
  approvedById String?
  createdAt    DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model Invoice {
  id               String        @id @default(cuid())
  propertyId       String
  number           String
  folioId          String?
  reservationId    String?
  guestId          String?
  companyId        String?
  status           InvoiceStatus @default(ISSUED)
  issuedAt         DateTime      @default(now())
  dueDate          DateTime?     @db.Date
  subtotal         Decimal       @default(0) @db.Decimal(18, 2)
  serviceCharge    Decimal       @default(0) @db.Decimal(18, 2)
  taxAmount        Decimal       @default(0) @db.Decimal(18, 2)
  total            Decimal       @default(0) @db.Decimal(18, 2)
  paidAmount       Decimal       @default(0) @db.Decimal(18, 2)
  balance          Decimal       @default(0) @db.Decimal(18, 2)
  currency         String        @default("VND")
  taxRateCode      String?
  eInvoiceProvider String?
  eInvoiceNo       String?
  eInvoiceUrl      String?
  eInvoiceStatus   String?
  buyerName        String?
  buyerTaxCode     String?
  buyerAddress     String?
  notes            String?
  voidReason       String?
  voidedAt         DateTime?
  createdById      String?

  property    Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  folio       Folio?        @relation(fields: [folioId], references: [id], onDelete: SetNull)
  reservation Reservation?  @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guest       Guest?        @relation(fields: [guestId], references: [id], onDelete: SetNull)
  company     Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  lines       InvoiceLine[]
  payments    Payment[]

  @@unique([propertyId, number])
  @@index([propertyId, issuedAt])
  @@index([folioId])
}

model InvoiceLine {
  id            String          @id @default(cuid())
  invoiceId     String
  description   String
